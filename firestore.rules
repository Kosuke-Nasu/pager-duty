rules_version = '2';

// PitchDuty の Firestore セキュリティルール
//
// 【重要】このルールはログイン不要の全開放です。
// プロジェクトID(pager-duty-28873)を知っている人なら誰でも
// 読み書きできます。氏名と当番以外の情報は保存しないでください。
//
// 反映方法: Firebase コンソール → Firestore Database → 「ルール」タブに
//           この内容を貼り付けて「公開」を押してください。
//           (このファイルを置いただけでは反映されません)

service cloud.firestore {
  match /databases/{database}/documents {

    // アプリが使う共有データ1件だけを許可する。
    // ほかのパスは下の既定どおり全拒否のまま。
    match /pitchduty/main {

      allow read: if true;

      // 書き込みはアプリが実際に送る形(json と updatedAt のみ)に限定する。
      // 全開放ではあるが、無関係な巨大データの投げ込みは防ぐ。
      // 削除時は request.resource が空になるためこの条件を満たさず、拒否される。
      allow write: if request.resource.data.keys().hasOnly(['json', 'updatedAt'])
                   && request.resource.data.json is string
                   && request.resource.data.json.size() < 500000
                   && request.resource.data.updatedAt is number;
    }
  }
}
